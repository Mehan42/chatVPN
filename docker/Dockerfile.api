# XVPN API Service Dockerfile with uv package manager
# Version: 1.0
# Author: XVPN Team
# Description: Optimized Docker image for XVPN API service using uv

# Многостадийная сборка для оптимизации размера образа

# === Стадия 1: Builder ===
FROM python:3.11-slim as builder

# Установка необходимых зависимостей для сборки
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Установка uv (быстрый пакетный менеджер)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.cargo/bin:$PATH"

# Копирование pyproject.toml для определения зависимостей
WORKDIR /app
COPY pyproject.toml README.md ./

# Установка зависимостей в виртуальное окружение uv
RUN uv pip install --system --no-cache-dir -e .

# Копирование исходного кода приложения
COPY ./server/api ./server/api
COPY ./server/admin ./server/admin
COPY ./server/agent ./server/agent

# Создание оптимизированного исполняемого файла с uv
RUN uvx pip install --system --no-cache-dir --editable .

# === Стадия 2: Runtime ===
FROM python:3.11-slim as runtime

# Установка зависимостей для выполнения (не для разработки)
RUN apt-get update && apt-get install -y \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Создание пользователя с ограниченными правами
RUN groupadd -r xvpn && useradd -r -g xvpn xvpn

# Установка uv (только для выполнения)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.cargo/bin:$PATH"

# Копирование установленных зависимостей из стадии builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Копирование исполняемых файлов и конфигурации
COPY --from=builder /app/server /app/server
COPY --from=builder /app/src /app/src
COPY --from=builder /usr/local/bin/xvpn* /usr/local/bin/

# Создание директорий для данных и логов
RUN mkdir -p /data /logs /config && \
    chown -R xvpn:xvpn /data /logs /config

# Копирование конфигурационных файлов
COPY ./config /config:ro

# Установка правильных прав
RUN chown -R xvpn:xvpn /app /usr/local/bin/xvpn*

# Переключение на пользователя с ограниченными правами
USER xvpn

# Установка рабочей директории
WORKDIR /app

# Expose ports
EXPOSE 8443

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8443/health || exit 1

# Запуск приложения с использованием uvx
CMD ["uvx", "run", "--app", "server.api.main:app"]