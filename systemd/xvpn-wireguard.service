# XVPN WireGuard Service
# Сервис WireGuard для XVPN (резервный вариант)

[Unit]
Description=XVPN WireGuard Service
After=network.target
Wants=network.target
Requires=network.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/xvpn/server/wireguard
RemainAfterExit=yes
ExecStart=/usr/bin/wg-quick up /opt/xvpn/server/wireguard/wg0.conf
ExecStop=/usr/bin/wg-quick down /opt/xvpn/server/wireguard/wg0.conf
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xvpn-wireguard

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/xvpn/server/wireguard /var/log/wireguard /opt/xvpn/data /tmp /var/run
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_SETGID CAP_SETUID
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_SETGID CAP_SETUID
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
RemoveIPC=true
PrivateUsers=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=256M
CPUQuota=10%
TasksMax=128

# Environment
Environment=PYTHONPATH=/opt/xvpn/server/wireguard
Environment=LOG_DIR=/var/log/wireguard
Environment=WIREGUARD_DIR=/opt/xvpn/server/wireguard
Environment=INTERVAL=60

[Install]
WantedBy=multi-user.target