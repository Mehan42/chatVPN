[Unit]
Description=XVPN Client Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=chatvpn
Group=chatvpn
WorkingDirectory=/home/chatvpn/client
ExecStart=/usr/bin/python3 /home/chatvpn/client/vpn_client.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/chatvpn/client
ReadWritePaths=/var/log/chatvpn
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE

# Resource limits
LimitNOFILE=65536
MemoryMax=512M

# Environment
Environment=PYTHONPATH=/home/chatvpn/client
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target