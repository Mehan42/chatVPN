[Unit]
Description=XVPN Client Service
After=network.target network-online.target
Wants=network.target network-online.target
Documentation=https://docs.xvpn.local

[Service]
Type=simple
User=chatvpn
Group=chatvpn
WorkingDirectory=/home/chatvpn/client
ExecStart=/usr/bin/python3 /home/chatvpn/client/vpn_client.py
Restart=always
RestartSec=5
RestartMaxRetries=3
StartLimitInterval=10min
StartLimitBurst=3
StandardOutput=journal
StandardError=journal
TimeoutStopSec=30

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/chatvpn/client /var/log/chatvpn
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
RemoveIPC=true
PrivateUsers=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=512M
CPUQuota=25%
TasksMax=256

# Environment
Environment=PYTHONPATH=/home/chatvpn/client
Environment=PYTHONUNBUFFERED=1
Environment=XVPN_LOG_LEVEL=INFO
Environment=XVPN_CONFIG_PATH=/home/chatvpn/client/config

# Health checking and monitoring
WatchdogSec=30
WatchdogSignal=SIGTERM

# Logging configuration
SyslogIdentifier=xvpn-client
SyslogLevel=info

[Install]
WantedBy=multi-user.target