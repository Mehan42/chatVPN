[Unit]
Description=XVPN Agent Service with uv
Documentation=https://docs.xvpn.local
After=network.target
Requires=network.target
Requires=xvpn-api.service

[Service]
Type=simple
User=xvpn
Group=xvpn
WorkingDirectory=/opt/xvpn
ExecStart=/usr/local/bin/uvx run --app server.agent.main:agent
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
Environment=PYTHONPATH=/opt/xvpn/src:/opt/xvpn/server/agent
Environment=PYTHONUNBUFFERED=1
Environment=LOG_LEVEL=INFO
Environment=DATABASE_URL=sqlite:///data/agent.db
Environment=MANIFEST_URL=http://localhost:8443/transports/manifest.json
Environment=HEALTH_URL=http://localhost:8443/mcp/v1/vpn.health
Environment=AGENT_CONFIG_FILE=/opt/xvpn/config/agent.json

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/xvpn/data /opt/xvpn/logs /opt/xvpn/pids
ReadWritePaths=/opt/xvpn/config
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
RemoveIPC=true
PrivateUsers=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=256M
CPUQuota=25%

# Health checking
WatchdogSec=30
WatchdogSignal=SIGTERM

[Install]
WantedBy=multi-user.target