# XVPN Traefik Service
# Сервис обратного прокси Traefik для XVPN

[Unit]
Description=XVPN Traefik Service
After=network.target docker.service
Wants=network.target docker.service
Requires=network.target docker.service

[Service]
Type=simple
User=traefik
Group=traefik
WorkingDirectory=/opt/xvpn/server/traefik
ExecStart=/usr/bin/traefik --configFile=/opt/xvpn/server/traefik/traefik.yml
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xvpn-traefik

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/xvpn/server/traefik /var/log/xvpn /opt/xvpn/data /letsencrypt
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
RemoveIPC=true
PrivateUsers=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=512M
CPUQuota=25%
TasksMax=256

# Environment
Environment=PYTHONPATH=/opt/xvpn/server/traefik
Environment=LOG_DIR=/var/log/xvpn
Environment=TRAEFIK_DIR=/opt/xvpn/server/traefik
Environment=INTERVAL=10

[Install]
WantedBy=multi-user.target