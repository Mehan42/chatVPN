# XVPN Telegram Bot Service
# Служба XVPN Telegram бота

[Unit]
Description=XVPN Telegram Bot Service
After=network.target xvpn-api.service
Wants=network.target xvpn-api.service
Requires=network.target xvpn-api.service

[Service]
Type=simple
User=uss
Group=uss
WorkingDirectory=/home/uss/chatvpn/server/admin
Environment=PYTHONPATH=/home/uss/chatvpn/server/admin
ExecStart=/usr/bin/python3 /home/uss/chatvpn/server/admin/tg_bot.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xvpn-bot

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/uss/chatvpn/server/admin /var/log/xvpn /opt/xvpn/data
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
RemoveIPC=true
PrivateUsers=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=256M
CPUQuota=10%
TasksMax=128

[Install]
WantedBy=multi-user.target