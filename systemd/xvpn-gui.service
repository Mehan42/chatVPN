# XVPN GUI Service
# Сервис графического интерфейса XVPN

[Unit]
Description=XVPN GUI Service
After=graphical-session.target
Wants=graphical-session.target
Requires=graphical-session.target

[Service]
Type=simple
User=uss
Group=uss
WorkingDirectory=/home/uss/chatvpn/client
Environment=PYTHONPATH=/home/uss/chatvpn/client
ExecStart=/usr/bin/python3 /home/uss/chatvpn/client/chatvpn_gui.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xvpn-gui

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/uss/chatvpn/client /var/log/xvpn /opt/xvpn/data
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
RemoveIPC=true
PrivateUsers=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=256M
CPUQuota=10%
TasksMax=128

[Install]
WantedBy=default.target