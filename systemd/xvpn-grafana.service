# XVPN Grafana Service
# Сервис визуализации Grafana для XVPN

[Unit]
Description=XVPN Grafana Service
After=network.target prometheus.service
Wants=network.target prometheus.service
Requires=network.target prometheus.service

[Service]
Type=simple
User=grafana
Group=grafana
WorkingDirectory=/opt/xvpn/server/grafana
ExecStart=/usr/bin/grafana-server \
  --config=/opt/xvpn/server/grafana/grafana.ini \
  --homepath=/usr/share/grafana \
  --packaging=docker
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xvpn-grafana

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/xvpn/server/grafana /var/lib/grafana /var/log/grafana /tmp
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
RemoveIPC=true
PrivateUsers=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=1G
CPUQuota=50%
TasksMax=512

# Environment
Environment=GF_PATHS_CONFIG=/opt/xvpn/server/grafana/grafana.ini
Environment=GF_PATHS_DATA=/var/lib/grafana
Environment=GF_PATHS_LOGS=/var/log/grafana
Environment=GF_PATHS_PLUGINS=/var/lib/grafana/plugins
Environment=GF_PATHS_PROVISIONING=/etc/grafana/provisioning
Environment=PYTHONPATH=/opt/xvpn/server/grafana
Environment=LOG_DIR=/var/log/grafana
Environment=MONITORING_DIR=/opt/xvpn/server/grafana
Environment=INTERVAL=60

[Install]
WantedBy=multi-user.target