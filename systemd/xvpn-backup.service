# XVPN Backup Service
# Сервис резервного копирования XVPN

[Unit]
Description=XVPN Backup Service
After=network.target
Wants=network.target
Requires=network.target

[Service]
Type=oneshot
User=xvpn
Group=xvpn
WorkingDirectory=/opt/xvpn/server/backup
Environment=PYTHONPATH=/opt/xvpn/server/backup
ExecStart=/usr/bin/python3 /opt/xvpn/server/backup/backup.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xvpn-backup

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/xvpn/server/backup /var/log/xvpn /opt/xvpn/data
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
RemoveIPC=true
PrivateUsers=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=256M
CPUQuota=10%
TasksMax=128

[Install]
WantedBy=multi-user.target