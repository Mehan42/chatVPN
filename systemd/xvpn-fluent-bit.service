# XVPN Fluent Bit Service
# Сервис агрегации логов Fluent Bit для XVPN

[Unit]
Description=XVPN Fluent Bit Service
After=network.target loki.service
Wants=network.target loki.service
Requires=network.target loki.service

[Service]
Type=simple
User=fluent-bit
Group=fluent-bit
WorkingDirectory=/opt/xvpn/server/fluent-bit
ExecStart=/usr/bin/fluent-bit \
  --config=/opt/xvpn/server/fluent-bit/fluent-bit.conf \
  --log-level=info \
  --log-format=json \
  --log-file=/var/log/fluent-bit/fluent-bit.log \
  --daemon=false \
  --flush=5 \
  --http-server=on \
  --http-listen=0.0.0.0 \
  --http-port=2020 \
  --health-check=on \
  --storage-metrics=on \
  --parsers-file=/opt/xvpn/server/fluent-bit/parsers.conf \
  --plugins-file=/opt/xvpn/server/fluent-bit/plugins.conf \
  --mem-buf-limit=5MB \
  --buffer-chunk-size=32k \
  --buffer-max-size=256k \
  --skip-long-lines=on \
  --read-from-head=true \
  --refresh-interval=5 \
  --db=/var/log/fluent-bit/fluent-bit.db \
  --tag=xvpn.* \
  --match=* \
  --host=loki \
  --port=3100 \
  --labels=job=xvpn-$TAG[1],service=$TAG[1],hostname=$hostname \
  --batch-wait=1s \
  --batch-size=1048576 \
  --timeout=10s \
  --proxy=off \
  --tls=off \
  --tls.verify=off \
  --tls.debug=1 \
  --http.user= \
  --http.passwd= \
  --format=json_lines \
  --path=/var/log/fluent-bit/aggregated.log \
  --uri=/logs \
  --header=Content-Type application/json
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xvpn-fluent-bit

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/xvpn/server/fluent-bit /var/log/fluent-bit /opt/xvpn/data /tmp
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
RemoveIPC=true
PrivateUsers=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=256M
CPUQuota=10%
TasksMax=128

# Environment
Environment=PYTHONPATH=/opt/xvpn/server/fluent-bit
Environment=LOG_DIR=/var/log/fluent-bit
Environment=FLUENT_BIT_DIR=/opt/xvpn/server/fluent-bit
Environment=INTERVAL=15

[Install]
WantedBy=multi-user.target