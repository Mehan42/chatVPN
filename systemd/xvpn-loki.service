# XVPN Loki Service
# Сервис агрегации логов Loki для XVPN

[Unit]
Description=XVPN Loki Service
After=network.target prometheus.service
Wants=network.target prometheus.service
Requires=network.target prometheus.service

[Service]
Type=simple
User=loki
Group=loki
WorkingDirectory=/opt/xvpn/server/loki
ExecStart=/usr/bin/loki \
  -config.file=/opt/xvpn/server/loki/loki.yml \
  -log.level=info \
  -log.format=logfmt \
  -log.file=/var/log/loki/loki.log
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xvpn-loki

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/xvpn/server/loki /var/log/loki /opt/xvpn/data /tmp
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
RemoveIPC=true
PrivateUsers=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=512M
CPUQuota=25%
TasksMax=256

# Environment
Environment=PYTHONPATH=/opt/xvpn/server/loki
Environment=LOG_DIR=/var/log/loki
Environment=LOKI_DIR=/opt/xvpn/server/loki
Environment=INTERVAL=30

[Install]
WantedBy=multi-user.target