# XVPN Alertmanager Service
# Сервис уведомлений Alertmanager для XVPN

[Unit]
Description=XVPN Alertmanager Service
After=network.target prometheus.service
Wants=network.target prometheus.service
Requires=network.target prometheus.service

[Service]
Type=simple
User=alertmanager
Group=alertmanager
WorkingDirectory=/opt/xvpn/server/alertmanager
ExecStart=/usr/bin/alertmanager --config.file=/opt/xvpn/server/alertmanager/alertmanager.yml --storage.path=/opt/xvpn/server/alertmanager/data
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xvpn-alertmanager

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/xvpn/server/alertmanager /var/log/xvpn /opt/xvpn/data
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
RemoveIPC=true
PrivateUsers=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=256M
CPUQuota=10%
TasksMax=128

# Environment
Environment=PYTHONPATH=/opt/xvpn/server/alertmanager
Environment=LOG_DIR=/var/log/xvpn
Environment=ALERTMANAGER_DIR=/opt/xvpn/server/alertmanager
Environment=INTERVAL=60

[Install]
WantedBy=multi-user.target