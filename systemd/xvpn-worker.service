# XVPN Worker Service
# Служба XVPN воркера

[Unit]
Description=XVPN Worker Service
After=network.target xvpn-api.service redis.service
Wants=network.target xvpn-api.service redis.service
Requires=network.target xvpn-api.service redis.service

[Service]
Type=simple
User=uss
Group=uss
WorkingDirectory=/home/uss/chatvpn/server/worker
Environment=PYTHONPATH=/home/uss/chatvpn/server/worker
ExecStart=/usr/bin/python3 /home/uss/chatvpn/server/worker/worker.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xvpn-worker

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/uss/chatvpn/server/worker /var/log/xvpn /opt/xvpn/data
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
RemoveIPC=true
PrivateUsers=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=512M
CPUQuota=25%
TasksMax=256

[Install]
WantedBy=multi-user.target