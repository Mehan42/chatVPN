# XVPN Client Service
# Служба XVPN клиента

[Unit]
Description=XVPN Client Service
After=network.target
Wants=network.target
Requires=network.target

[Service]
Type=simple
User=uss
Group=uss
WorkingDirectory=/home/uss/chatvpn/client
Environment=PYTHONPATH=/home/uss/chatvpn/client
ExecStart=/usr/bin/python3 /home/uss/chatvpn/client/chatvpn_backend.py start
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xvpn-client

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/uss/chatvpn/client /var/log/xvpn
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
RemoveIPC=true
PrivateUsers=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=512M
CPUQuota=25%
TasksMax=256

[Install]
WantedBy=multi-user.target