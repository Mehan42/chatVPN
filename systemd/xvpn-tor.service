# XVPN Tor Service
# Сервис Tor для XVPN (для дополнительной анонимизации)

[Unit]
Description=XVPN Tor Service
After=network.target
Wants=network.target
Requires=network.target

[Service]
Type=simple
User=tor
Group=tor
WorkingDirectory=/opt/xvpn/server/tor
ExecStart=/usr/bin/tor \
  -f /opt/xvpn/server/tor/torrc \
  --defaults-torrc /opt/xvpn/server/tor/torrc.defaults \
  --quiet \
  --hush \
  --DataDirectory /opt/xvpn/server/tor/data \
  --PidFile /var/run/tor/tor.pid \
  --Log "notice file /var/log/tor/notices.log" \
  --Log "warn file /var/log/tor/warnings.log" \
  --Log "err file /var/log/tor/errors.log" \
  --Log "debug file /var/log/tor/debug.log" \
  --SocksPort 9050 \
  --SocksListenAddress 127.0.0.1:9050 \
  --ControlPort 9051 \
  --ControlListenAddress 127.0.0.1:9051 \
  --CookieAuthentication 1 \
  --CookieAuthFile /opt/xvpn/server/tor/control_auth_cookie \
  --HashedControlPassword $${HASHED_CONTROL_PASSWORD} \
  --HiddenServiceDir /opt/xvpn/server/tor/hidden_services \
  --HiddenServicePort 80 127.0.0.1:80 \
  --HiddenServicePort 443 127.0.0.1:443 \
  --HiddenServicePort 8443 127.0.0.1:8443 \
  --HiddenServiceVersion 3 \
  --HiddenServiceMaxStreams 64 \
  --HiddenServiceMaxStreamsCloseCircuit 1 \
  --HiddenServiceStatistics 1 \
  --HiddenServiceSingleHopMode 0 \
  --HiddenServiceNonAnonymousMode 0 \
  --UseBridges 0 \
  --Bridge \
  --ClientTransportPlugin obfs4 exec /usr/bin/obfs4proxy \
  --ClientTransportPlugin meek_lite exec /usr/bin/meek-client \
  --ClientTransportPlugin snowflake exec /usr/bin/snowflake-client \
  --ReachableAddresses *:80,*:443,*:53 \
  --ReachableDirAddresses *:80,*:443,*:53 \
  --ReachableORAddresses *:443,*:53 \
  --ClientUseIPv4 1 \
  --ClientUseIPv6 1 \
  --ClientPreferIPv6ORPort 1 \
  --ClientPreferIPv6DirPort 1 \
  --EntryNodes {RU},{BY},{KZ},{KG},{MD},{UA},{AM},{GE},{AZ},{UZ},{TM},{TJ},{KG} \
  --ExitNodes {RU},{BY},{KZ},{KG},{MD},{UA},{AM},{GE},{AZ},{UZ},{TM},{TJ},{KG} \
  --ExcludeNodes {CN},{IR},{KP},{SY},{SA},{YE},{IQ},{SD},{AF},{PK},{BD},{LK},{MV},{BT},{NP},{MM},{KH},{LA},{VN},{TH},{MY},{BN},{ID},{PH},{TL},{PG},{SB},{VU},{NR},{TV},{TO},{WS},{AS},{CK},{NU},{TK},{WF},{PF},{NC},{WF},{PF},{NC} \
  --ExcludeExitNodes {CN},{IR},{KP},{SY},{SA},{YE},{IQ},{SD},{AF},{PK},{BD},{LK},{MV},{BT},{NP},{MM},{KH},{LA},{VN},{TH},{MY},{BN},{ID},{PH},{TL},{PG},{SB},{VU},{NR},{TV},{TO},{WS},{AS},{CK},{NU},{TK},{WF},{PF},{NC},{WF},{PF},{NC} \
  --StrictNodes 1 \
  --FascistFirewall 0 \
  --FirewallPorts 80,443,53 \
  --LongLivedPorts 21,22,706,1863,5050,5190,5222,5223,6523,6667,6697,8300 \
  --NewCircuitPeriod 30 \
  --MaxCircuitDirtiness 600 \
  --CircuitBuildTimeout 60 \
  --LearnCircuitBuildTimeout 1 \
  --CircuitsAvailableTimeout 60 \
  --CircuitStreamTimeout 180 \
  --HeartbeatPeriod 1800 \
  --KeepalivePeriod 300 \
  --SocksTimeout 120 \
  --TokenBucketRefillInterval 100 \
  --BandwidthRate 1048576 \
  --BandwidthBurst 2097152 \
  --MaxAdvertisedBandwidth 1048576 \
  --RelayBandwidthRate 1048576 \
  --RelayBandwidthBurst 2097152 \
  --PerConnBWRate 262144 \
  --PerConnBWBurst 524288 \
  --ConnLimit 60 \
  --RunAsDaemon 1 \
  --AvoidDiskWrites 1 \
  --SysLog 1 \
  --SafeLogging 1 \
  --SafeSocks 1 \
  --TestSocks 1 \
  --WarnUnsafeSocks 1 \
  --HardwareAccel 1 \
  --DisableDebuggerAttachment 1 \
  --NoExec 1 \
  --MemoryConserve 1 \
  --ReducedExitPolicy 1 \
  --UseEntryGuards 1 \
  --NumEntryGuards 3 \
  --NumDirectoryGuards 3 \
  --GuardLifetime 2592000 \
  --GeoIPExcludeUnknown 1 \
  --UseMicrodescriptors 1 \
  --MicrodescriptorCacheFile /opt/xvpn/server/tor/cache/microdesc_cache \
  --DownloadExtraInfo 1 \
  --ConsensusParams circuit_rank_scale=20000,circuit_rank_scale_between_authorities=20000
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xvpn-tor

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/xvpn/server/tor /var/log/tor /opt/xvpn/data /tmp /var/run/tor
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
RemoveIPC=true
PrivateUsers=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=512M
CPUQuota=25%
TasksMax=256

# Environment
Environment=PYTHONPATH=/opt/xvpn/server/tor
Environment=LOG_DIR=/var/log/tor
Environment=TOR_DIR=/opt/xvpn/server/tor
Environment=INTERVAL=30

[Install]
WantedBy=multi-user.target