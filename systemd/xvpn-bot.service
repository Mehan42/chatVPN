[Unit]
Description=XVPN Bot Service with uv
Documentation=https://docs.xvpn.local
After=network.target
Requires=network.target
Requires=xvpn-api.service

[Service]
Type=simple
User=xvpn
Group=xvpn
WorkingDirectory=/opt/xvpn
ExecStart=/usr/local/bin/uvx run --app server.admin.main:bot
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
Environment=PYTHONPATH=/opt/xvpn/src:/opt/xvpn/server/admin
Environment=PYTHONUNBUFFERED=1
Environment=LOG_LEVEL=INFO
Environment=BOT_CONFIG_FILE=/opt/xvpn/config/bot.json
Environment=API_BASE_URL=https://localhost:8443

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/xvpn/data /opt/xvpn/logs /opt/xvpn/pids
ReadWritePaths=/opt/xvpn/config
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
RemoveIPC=true
PrivateUsers=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=128M
CPUQuota=10%

# Watchdog for monitoring
WatchdogSec=30
WatchdogSignal=SIGTERM

# Security: Restrict filesystem access
ReadOnlyPaths=/opt/xvpn/config
RestrictRealtime=true
RestrictNamespaces=true

[Install]
WantedBy=multi-user.target