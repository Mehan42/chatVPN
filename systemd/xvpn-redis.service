# XVPN Redis Service
# Сервис кэширования Redis для XVPN

[Unit]
Description=XVPN Redis Service
After=network.target
Wants=network.target
Requires=network.target

[Service]
Type=simple
User=redis
Group=redis
WorkingDirectory=/opt/xvpn/server/redis
ExecStart=/usr/bin/redis-server /opt/xvpn/server/redis/redis.conf
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xvpn-redis

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/xvpn/server/redis /var/log/xvpn /opt/xvpn/data
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
RemoveIPC=true
PrivateUsers=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=256M
CPUQuota=10%
TasksMax=128

# Environment
Environment=PYTHONPATH=/opt/xvpn/server/redis
Environment=LOG_DIR=/var/log/xvpn
Environment=REDIS_DIR=/opt/xvpn/server/redis
Environment=INTERVAL=60

[Install]
WantedBy=multi-user.target