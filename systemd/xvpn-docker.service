[Unit]
Description=XVPN Docker Compose Service Manager
Documentation=https://docs.docker.com/compose
After=docker.service
Requires=docker.service
After=network.target
Requires=network.target
Before=xvpn-api.service
Before=xvpn-agent.service
Before=xvpn-bot.service
Before=xvpn-worker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=docker
WorkingDirectory=/opt/xvpn
ExecStart=/usr/bin/docker-compose -f /opt/xvpn/docker-compose.yml up -d
ExecStop=/usr/bin/docker-compose -f /opt/xvpn/docker-compose.yml down
ExecReload=/usr/bin/docker-compose -f /opt/xvpn/docker-compose.yml up -d --force-recreate
TimeoutStartSec=0
TimeoutStopSec=30
Restart=on-failure
RestartSec=10

# Security settings
NoNewPrivileges=false
PrivateTmp=false
ProtectSystem=strict
ReadWritePaths=/opt/xvpn
ReadWritePaths=/var/run/docker.sock
ReadWritePaths=/var/lib/docker
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
RemoveIPC=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=1G
CPUQuota=100%

[Install]
WantedBy=multi-user.target