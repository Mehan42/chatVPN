{
  "uuid": "example-client-uuid",
  "created_at": "2025-10-04T12:00:00Z",
  "expires_at": "2026-10-04T12:00:00Z",
  "name": "Example Client",
  "description": "Example client configuration for testing",
  "transports": [
    {
      "id": "vless-reality-1",
      "name": "VLESS + Reality Transport 1",
      "type": "vless-reality",
      "priority": 1,
      "ipv6": true,
      "need_udp": false,
      "config": {
        "server": "example1.server.com",
        "port": 443,
        "protocol": "tcp",
        "settings": {
          "vnext": [
            {
              "address": "example1.server.com",
              "port": 443,
              "users": [
                {
                  "id": "example-client-uuid",
                  "encryption": "none",
                  "level": 8
                }
              ]
            }
          ]
        },
        "streamSettings": {
          "network": "tcp",
          "security": "reality",
          "realitySettings": {
            "show": false,
            "fingerprint": "chrome",
            "serverName": "example1.server.com",
            "publicKey": "example-public-key-here",
            "shortId": "example-short-id"
          },
          "tcpSettings": {
            "header": {
              "type": "none"
            }
          }
        }
      }
    },
    {
      "id": "vmess-ws-1",
      "name": "VMess + WebSocket Transport 1",
      "type": "vmess-ws",
      "priority": 2,
      "ipv6": true,
      "need_udp": false,
      "config": {
        "server": "example2.server.com",
        "port": 443,
        "protocol": "vmess",
        "settings": {
          "vnext": [
            {
              "address": "example2.server.com",
              "port": 443,
              "users": [
                {
                  "id": "example-client-uuid",
                  "alterId": 0,
                  "security": "auto",
                  "level": 8
                }
              ]
            }
          ]
        },
        "streamSettings": {
          "network": "ws",
          "security": "tls",
          "tlsSettings": {
            "serverName": "example2.server.com",
            "allowInsecure": false
          },
          "wsSettings": {
            "path": "/websocket",
            "headers": {
              "Host": "example2.server.com"
            }
          }
        }
      }
    },
    {
      "id": "trojan-tcp-1",
      "name": "Trojan + TCP Transport 1",
      "type": "trojan-tcp",
      "priority": 3,
      "ipv6": true,
      "need_udp": false,
      "config": {
        "server": "example3.server.com",
        "port": 443,
        "protocol": "trojan",
        "settings": {
          "servers": [
            {
              "address": "example3.server.com",
              "port": 443,
              "password": "example-password-here",
              "level": 8
            }
          ]
        },
        "streamSettings": {
          "network": "tcp",
          "security": "tls",
          "tlsSettings": {
            "serverName": "example3.server.com",
            "allowInsecure": false
          }
        }
      }
    }
  ],
  "settings": {
    "auto_connect": true,
    "auto_transport_switch": true,
    "transport_switch_threshold": 3,
    "health_check_interval": 30,
    "proxy_mode": "tun",
    "ipv6_enabled": true,
    "kill_switch": true,
    "dns_leak_protection": true,
    "log_level": "INFO"
  }
}