{
  "server": {
    "host": "0.0.0.0",
    "port": 8443,
    "ssl_cert": "/opt/xvpn/tls/cert.pem",
    "ssl_key": "/opt/xvpn/tls/key.pem",
    "ssl_enabled": true,
    "debug": false
  },
  "database": {
    "url": "sqlite:////opt/xvpn/db/xvpn.db",
    "pool_size": 10,
    "max_overflow": 20
  },
  "redis": {
    "url": "redis://localhost:6379/0",
    "pool_size": 10
  },
  "telegram": {
    "bot_token": "your_telegram_bot_token_here",
    "chat_id": "your_chat_id_here",
    "enabled": true
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file": "/var/log/xvpn/api.log",
    "max_bytes": 10485760,
    "backup_count": 5
  },
  "security": {
    "jwt_secret": "your_jwt_secret_here",
    "jwt_algorithm": "HS256",
    "jwt_expire_hours": 24,
    "allowed_origins": ["*"],
    "rate_limit": {
      "requests_per_minute": 60,
      "burst_limit": 10
    }
  },
  "monitoring": {
    "prometheus_enabled": true,
    "prometheus_port": 9090,
    "health_check_interval": 30
  },
  "transports": {
    "manifest_refresh_interval": 300,
    "default_transport": "vless-reality-1",
    "max_transports_per_client": 5
  },
  "clients": {
    "default_config_ttl_days": 365,
    "max_clients": 1000,
    "client_config_dir": "/opt/xvpn/data/clients"
  }
}