# XVPN Performance Monitor Service
# Сервис мониторинга производительности для XVPN

[Unit]
Description=XVPN Performance Monitor Service
After=network.target xvpn-api.service
Wants=network.target xvpn-api.service
Requires=network.target xvpn-api.service

[Service]
Type=simple
User=perf-monitor
Group=perf-monitor
WorkingDirectory=/opt/xvpn/server/perf-monitor
ExecStart=/usr/bin/python3 /opt/xvpn/server/perf-monitor/perf_monitor.py \
  --config=/opt/xvpn/server/perf-monitor/config.json \
  --log-file=/var/log/perf-monitor/perf-monitor.log \
  --log-level=INFO \
  --log-format=json \
  --api-url=https://perf-monitor.xvpn.local \
  --api-port=8452 \
  --metrics-url=http://perf-monitor-metrics:9090 \
  --metrics-port=9090 \
  --proxy-uri=https://perf-proxy.xvpn.local \
  --listen=0.0.0.0:8452 \
  --listen-ipv6=[::]:8452 \
  --forward-proxy \
  --forward-proxy-host=forward-proxy.xvpn.local \
  --forward-proxy-port=1080 \
  --forward-proxy-username=${FORWARD_PROXY_USERNAME} \
  --forward-proxy-password=${FORWARD_PROXY_PASSWORD} \
  --forward-proxy-protocol=socks5 \
  --forward-proxy-tls=true \
  --forward-proxy-tls-verify=true \
  --forward-proxy-tls-cert=/opt/xvpn/server/perf-monitor/certs/forward-proxy.crt \
  --forward-proxy-tls-key=/opt/xvpn/server/perf-monitor/certs/forward-proxy.key \
  --forward-proxy-tls-ca=/opt/xvpn/server/perf-monitor/certs/ca.crt \
  --forward-proxy-tls-cipher-suites=TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384,TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384,TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305,TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305 \
  --forward-proxy-tls-curves=CurveP521,CurveP384,CurveP256 \
  --forward-proxy-tls-prefer-server-cipher-suites=true \
  --forward-proxy-tls-session-tickets=true \
  --forward-proxy-tls-alpn-protocols=h2,http/1.1 \
  --forward-proxy-tls-renegotiation-support=NoRenegotiation \
  --forward-proxy-tls-max-version=VersionTLS13 \
  --forward-proxy-tls-min-version=VersionTLS12 \
  --forward-proxy-tls-compression=snappy \
  --forward-proxy-tls-prefetch=true \
  --forward-proxy-tls-prefetch-parallelism=4 \
  --forward-proxy-tls-cache=true \
  --forward-proxy-tls-cache-type=inmemory \
  --forward-proxy-tls-cache-memory-size=536870912 \
  --forward-proxy-tls-cache-ttl=1h \
  --forward-proxy-tls-cache-eviction-strategy=lru \
  --forward-proxy-tls-cache-compression=snappy \
  --forward-proxy-tls-cache-prefetch=true \
  --forward-proxy-tls-cache-prefetch-parallelism=4
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xvpn-perf-monitor

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/xvpn/server/perf-monitor /var/log/perf-monitor /opt/xvpn/data /tmp /var/run
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_SETGID CAP_SETUID
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_SETGID CAP_SETUID
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
RemoveIPC=true
PrivateUsers=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=256M
CPUQuota=10%
TasksMax=128

# Environment
Environment=PYTHONPATH=/opt/xvpn/server/perf-monitor
Environment=LOG_DIR=/var/log/perf-monitor
Environment=PERF_MONITOR_DIR=/opt/xvpn/server/perf-monitor
Environment=INTERVAL=30
Environment=FORWARD_PROXY_USERNAME=${FORWARD_PROXY_USERNAME}
Environment=FORWARD_PROXY_PASSWORD=${FORWARD_PROXY_PASSWORD}

[Install]
WantedBy=multi-user.target