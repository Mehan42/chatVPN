# XVPN PostgreSQL Service
# Сервис базы данных PostgreSQL для XVPN

[Unit]
Description=XVPN PostgreSQL Service
After=network.target
Wants=network.target
Requires=network.target

[Service]
Type=simple
User=postgres
Group=postgres
WorkingDirectory=/opt/xvpn/server/postgres
ExecStart=/usr/bin/postgres -D /opt/xvpn/server/postgres/data -c config_file=/opt/xvpn/server/postgres/postgresql.conf
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xvpn-postgres

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/xvpn/server/postgres /var/log/xvpn /opt/xvpn/data
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_DAC_OVERRIDE
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
RemoveIPC=true
PrivateUsers=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=1G
CPUQuota=50%
TasksMax=512

# Environment
Environment=PYTHONPATH=/opt/xvpn/server/postgres
Environment=LOG_DIR=/var/log/xvpn
Environment=POSTGRES_DIR=/opt/xvpn/server/postgres
Environment=INTERVAL=30

[Install]
WantedBy=multi-user.target