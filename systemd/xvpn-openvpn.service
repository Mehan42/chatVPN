# XVPN OpenVPN Service
# Сервис OpenVPN для XVPN (резервный вариант)

[Unit]
Description=XVPN OpenVPN Service
After=network.target
Wants=network.target
Requires=network.target

[Service]
Type=notify
User=root
Group=root
WorkingDirectory=/opt/xvpn/server/openvpn
ExecStart=/usr/sbin/openvpn \
  --config /opt/xvpn/server/openvpn/openvpn.conf \
  --daemon \
  --writepid /var/run/openvpn.pid \
  --status /var/log/openvpn/status.log \
  --log-append /var/log/openvpn/openvpn.log \
  --verb 3 \
  --mute 10 \
  --persist-key \
  --persist-tun \
  --comp-lzo \
  --cipher AES-256-CBC \
  --auth SHA256 \
  --tls-auth /opt/xvpn/server/openvpn/ta.key \
  --tls-cipher TLS-ECDHE-RSA-WITH-AES-256-GCM-SHA384 \
  --auth-nocache \
  --auth-user-pass /opt/xvpn/server/openvpn/auth.txt \
  --remote-cert-tls server \
  --reneg-sec 3600 \
  --hand-window 60 \
  --tran-window 300 \
  --resolv-retry infinite \
  --nobind \
  --client \
  --dev tun \
  --proto udp \
  --remote vpn.xvpn.local 1194 \
  --ca /opt/xvpn/server/openvpn/ca.crt \
  --cert /opt/xvpn/server/openvpn/client.crt \
  --key /opt/xvpn/server/openvpn/client.key \
  --dh /opt/xvpn/server/openvpn/dh2048.pem \
  --tls-client \
  --tls-version-min 1.2 \
  --tls-version-max 1.3 \
  --tls-cipher TLS-ECDHE-ECDSA-WITH-AES-256-GCM-SHA384:TLS-ECDHE-RSA-WITH-AES-256-GCM-SHA384:TLS-ECDHE-ECDSA-WITH-AES-128-GCM-SHA256:TLS-ECDHE-RSA-WITH-AES-128-GCM-SHA256 \
  --tls-timeout 2 \
  --connect-timeout 120 \
  --connect-retry 5 \
  --connect-retry-max 5 \
  --float \
  --fast-io \
  --inactive 3600 \
  --ping 10 \
  --ping-restart 120 \
  --ping-timer-rem \
  --explicit-exit-notify 1 \
  --mute-replay-warnings \
  --replay-window 64 \
  --replay-persist /var/log/openvpn/replay-state \
  --key-direction 1 \
  --ns-cert-type server \
  --remote-cert-ku 0x80 \
  --remote-cert-eku "TLS Web Server Authentication" \
  --verify-x509-name "xvpn-server" name \
  --x509-username-field CN \
  --username-as-common-name \
  --auth-retry interact \
  --port-share 127.0.0.1 8443 \
  --management 127.0.0.1 6001 \
  --management-client \
  --management-query-passwords \
  --management-query-proxy \
  --management-query-remote \
  --management-external-cert-check
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xvpn-openvpn

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/xvpn/server/openvpn /var/log/openvpn /opt/xvpn/data /tmp /var/run
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_SETGID CAP_SETUID
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_SETGID CAP_SETUID
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
RemoveIPC=true
PrivateUsers=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=512M
CPUQuota=25%
TasksMax=256

# Environment
Environment=PYTHONPATH=/opt/xvpn/server/openvpn
Environment=LOG_DIR=/var/log/openvpn
Environment=OPENVPN_DIR=/opt/xvpn/server/openvpn
Environment=INTERVAL=30

[Install]
WantedBy=multi-user.target