[Unit]
Description=XVPN GUI Service
Documentation=https://docs.xvpn.local
After=network.target xvpn-client.service
Requires=xvpn-client.service

[Service]
Type=simple
User=xvpn
Group=xvpn
WorkingDirectory=/opt/xvpn/client
ExecStart=/usr/bin/python3 /opt/xvpn/scripts/run_gui.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
Environment=LOG_LEVEL=INFO
Environment=DISPLAY=:0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/xvpn/client /home/xvpn/.chatvpn
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_VSOCK
RestrictSUIDSGID=true
RemoveIPC=true
PrivateUsers=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=256M
CPUQuota=25%

# Timeout settings
TimeoutStartSec=30
TimeoutStopSec=10

# Environment for GUI
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=GTK_MODULES=appmenu-gtk-module

[Install]
WantedBy=multi-user.target