# XVPN Orchestrator Service
# Служба XVPN оркестратора

[Unit]
Description=XVPN Orchestrator Service
After=network.target xvpn-api.service xvpn-agent.service
Wants=network.target xvpn-api.service xvpn-agent.service
Requires=network.target xvpn-api.service xvpn-agent.service

[Service]
Type=simple
User=uss
Group=uss
WorkingDirectory=/home/uss/chatvpn/server/agent
Environment=PYTHONPATH=/home/uss/chatvpn/server/agent
ExecStart=/usr/bin/python3 /home/uss/chatvpn/server/agent/orchestrator.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xvpn-orchestrator

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/uss/chatvpn/server/agent /var/log/xvpn /opt/xvpn/data
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
RemoveIPC=true
PrivateUsers=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=1G
CPUQuota=50%
TasksMax=512

[Install]
WantedBy=multi-user.target