# XVPN Certbot Service
# Сервис автоматического получения SSL сертификатов Certbot для XVPN

[Unit]
Description=XVPN Certbot Service
After=network.target nginx.service
Wants=network.target nginx.service
Requires=network.target nginx.service

[Service]
Type=oneshot
User=certbot
Group=certbot
WorkingDirectory=/opt/xvpn/server/certbot
ExecStart=/usr/bin/certbot \
  --nginx \
  --non-interactive \
  --agree-tos \
  --email admin@xvpn.local \
  --domains api.xvpn.local,bot.xvpn.local,grafana.xvpn.local,traefik.xvpn.local,vpn.xvpn.local,orchestrator.xvpn.local,worker.xvpn.local,agent.xvpn.local \
  --expand \
  --renew-by-default \
  --keep-until-expiring \
  --allow-subset-of-names \
  --rsa-key-size 4096 \
  --redirect \
  --hsts \
  --uir \
  --staple-ocsp \
  --must-staple \
  --preferred-challenges http-01 \
  --http-01-port 80 \
  --https-port 443 \
  --reuse-key \
  --key-type rsa \
  --cert-name xvpn-cert \
  --work-dir /var/lib/letsencrypt \
  --logs-dir /var/log/letsencrypt \
  --config-dir /etc/letsencrypt \
  --preconfigured-renewal \
  --disable-hook-validation \
  --no-self-upgrade \
  --user-agent "XVPN-Certbot/1.0.0" \
  --debug-challenges \
  --debug \
  --verbose
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xvpn-certbot

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/xvpn/server/certbot /var/log/certbot /opt/xvpn/data /tmp /etc/letsencrypt /var/lib/letsencrypt /var/log/letsencrypt
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
RemoveIPC=true
PrivateUsers=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=256M
CPUQuota=10%
TasksMax=128

# Environment
Environment=PYTHONPATH=/opt/xvpn/server/certbot
Environment=LOG_DIR=/var/log/certbot
Environment=CERTBOT_DIR=/opt/xvpn/server/certbot
Environment=INTERVAL=86400  # 24 часа

[Install]
WantedBy=multi-user.target