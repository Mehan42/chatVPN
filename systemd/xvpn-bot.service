[Unit]
Description=XVPN Bot Service with uv
Documentation=https://docs.xvpn.local
After=network.target network-online.target
Requires=network.target
Requires=xvpn-api.service xvpn-redis.service

[Service]
Type=simple
User=xvpn
Group=xvpn
WorkingDirectory=/opt/xvpn
ExecStart=/usr/local/bin/uvx run --app server.admin.main:bot
Restart=always
RestartSec=5
RestartMaxRetries=3
StartLimitInterval=10min
StartLimitBurst=3
StandardOutput=journal
StandardError=journal
TimeoutStopSec=30
TimeoutStartSec=30

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/xvpn/data /opt/xvpn/logs /opt/xvpn/pids
ReadOnlyPaths=/opt/xvpn/config
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
RemoveIPC=true
PrivateUsers=true
ProtectKernelLogs=true
ProtectHostname=true
RestrictRealtime=true
RestrictNamespaces=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=128M
CPUQuota=10%
TasksMax=256

# Environment
Environment=PYTHONPATH=/opt/xvpn/src:/opt/xvpn/server/admin
Environment=PYTHONUNBUFFERED=1
Environment=LOG_LEVEL=INFO
Environment=BOT_CONFIG_FILE=/opt/xvpn/config/bot.json
Environment=API_BASE_URL=https://localhost:8443
Environment=BOT_WEBHOOK_TIMEOUT=60
Environment=BOT_POLLING_INTERVAL=30

# Health checking and monitoring
WatchdogSec=30
WatchdogSignal=SIGTERM

# Logging configuration
SyslogIdentifier=xvpn-bot
SyslogLevel=info

# Dependencies and ordering
BindsTo=xvpn-api.service xvpn-redis.service
After=xvpn-api.service xvpn-redis.service

[Install]
WantedBy=multi-user.target