# XVPN Node Exporter Service
# Сервис экспорта системных метрик Node Exporter для XVPN

[Unit]
Description=XVPN Node Exporter Service
After=network.target prometheus.service
Wants=network.target prometheus.service
Requires=network.target prometheus.service

[Service]
Type=simple
User=node-exporter
Group=node-exporter
WorkingDirectory=/opt/xvpn/server/node-exporter
ExecStart=/usr/bin/node_exporter \
  --web.listen-address=0.0.0.0:9100 \
  --web.telemetry-path=/metrics \
  --log.level=info \
  --log.format=logfmt \
  --collector.textfile.directory=/opt/xvpn/server/node-exporter/textfile_collector \
  --collector.systemd \
  --collector.processes \
  --collector.cpu.info \
  --collector.diskstats \
  --collector.filesystem \
  --collector.loadavg \
  --collector.meminfo \
  --collector.netdev \
  --collector.netstat \
  --collector.stat \
  --collector.time \
  --collector.uname \
  --collector.vmstat \
  --collector.entropy \
  --collector.bonding \
  --collector.thermal_zone \
  --collector.hwmon \
  --collector.interrupts \
  --collector.ksmd \
  --collector.logind \
  --collector.meminfo_numa \
  --collector.mountstats \
  --collector.netclass \
  --collector.netstat.fields="^(.*_bytes_.*)$" \
  --collector.qdisc \
  --collector.runit \
  --collector.sockstat \
  --collector.supervisord \
  --collector.systemd.unit-include=".*" \
  --collector.systemd.unit-exclude="user.*"
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xvpn-node-exporter

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/xvpn/server/node-exporter /var/log/node-exporter /tmp
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
RemoveIPC=true
PrivateUsers=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=256M
CPUQuota=10%
TasksMax=128

# Environment
Environment=PYTHONPATH=/opt/xvpn/server/node-exporter
Environment=LOG_DIR=/var/log/node-exporter
Environment=NODE_EXPORTER_DIR=/opt/xvpn/server/node-exporter
Environment=INTERVAL=15

[Install]
WantedBy=multi-user.target