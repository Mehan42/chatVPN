# XVPN Agent Service
# Служба XVPN агента

[Unit]
Description=XVPN Agent Service
After=network.target xvpn-api.service
Wants=network.target xvpn-api.service
Requires=network.target xvpn-api.service

[Service]
Type=simple
User=uss
Group=uss
WorkingDirectory=/home/uss/chatvpn/server/agent
Environment=PYTHONPATH=/home/uss/chatvpn/server/agent
ExecStart=/usr/bin/python3 /home/uss/chatvpn/server/agent/agent.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xvpn-agent

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/uss/chatvpn/server/agent /var/log/xvpn /opt/xvpn/data
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
RemoveIPC=true
PrivateUsers=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=512M
CPUQuota=25%
TasksMax=256

[Install]
WantedBy=multi-user.target